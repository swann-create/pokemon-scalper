# Copie ce fichier en .env, puis remplis uniquement les valeurs disponibles.
# Ne partage jamais le fichier .env.

DISCORD_WEBHOOK_URL=

# API Browse officielle eBay. Laisser vide désactive simplement eBay.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_DELIVERY_POSTAL_CODE=75001

# Découverte automatique sur les recherches publiques E.Leclerc.
# Une heure entre deux recherches limite la charge et les risques de blocage.
POKESTOCK_AUTO_DISCOVERY=true
POKESTOCK_DISCOVERY_INTERVAL_SECONDS=3600
POKESTOCK_DISCOVERY_QUERIES=pokemon booster,pokemon coffret,pokemon cartes
POKESTOCK_DISCOVERY_LIMIT_PER_QUERY=50
POKESTOCK_DISCOVERY_MAX_NEW_PER_RUN=10

# Les pages publiques sont vérifiées par petits lots avec une pause entre
# chaque requête. Les flux Awin ne sont pas concernés par ces limites.
POKESTOCK_MAX_DIRECT_PRODUCTS_PER_STORE=4
POKESTOCK_DIRECT_REQUEST_DELAY_SECONDS=1.5

# Catégories marketplace acceptées uniquement si leur prix reste sous le
# plafond configuré ci-dessous. Une valeur vide ignore toutes les marketplaces.
POKESTOCK_MARKETPLACE_CATEGORIES=etb,coffret

# Plafonds facultatifs en euros. Une valeur vide désactive le filtre de la
# catégorie. Le bot continue d'enregistrer le prix, mais n'envoie pas d'alerte
# au-dessus du plafond.
POKESTOCK_MAX_PRICE_BOOSTER=
POKESTOCK_MAX_PRICE_PACK=
POKESTOCK_MAX_PRICE_BUNDLE=
POKESTOCK_MAX_PRICE_DISPLAY=
POKESTOCK_MAX_PRICE_ETB=60
POKESTOCK_MAX_PRICE_COFFRET=50
POKESTOCK_MAX_PRICE_DECK=
POKESTOCK_MAX_PRICE_OTHER=

# À remplir après l'approbation de chaque programme Awin.
AWIN_FEED_FNAC_URL=
AWIN_FEED_CULTURA_URL=
AWIN_FEED_LECLERC_URL=
AWIN_FEED_DARTY_URL=
AWIN_FEED_RAKUTEN_URL=

# Les flux Awin ne seront jamais téléchargés plus souvent que toutes les
# 15 minutes. Une heure est recommandée.
AWIN_FEED_REFRESH_SECONDS=3600
